# ==============================================================================
# VGS Retail OS - Local Environment Variable Template (.env.example)
# ==============================================================================
# Copy this file to '.env' in your local environment for development/Docker.
# NEVER commit real credentials, passwords, or production secrets to Git.
# ==============================================================================

# --- PostgreSQL Database ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5435
POSTGRES_DB=vgs_retail_os_dev
POSTGRES_USER=vgs_dev
POSTGRES_PASSWORD=vgs_dev_password_placeholder

# --- Redis Cache ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Backend Host (ASP.NET Core) ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=5000
ASPNETCORE_HTTPS_PORTS=5001

# Connection String Environment Overrides:
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=vgs_retail_os_dev;Username=vgs_dev;Password=vgs_dev_password_placeholder
# ConnectionStrings__Redis=localhost:6379

# --- Security / JWT (Development Placeholders) ---
JWT_SECRET_KEY=vgs_dev_jwt_signing_key_min_32_characters_long_placeholder
JWT_ISSUER=VGS.RetailOS
JWT_AUDIENCE=VGS.RetailOS.App
JWT_EXPIRATION_MINUTES=60

# --- Frontend (Angular) ---
FRONTEND_PORT=4200
API_BASE_URL=http://localhost:5000/api/v1
